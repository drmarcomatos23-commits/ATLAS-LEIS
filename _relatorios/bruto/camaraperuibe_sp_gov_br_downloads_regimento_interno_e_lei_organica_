    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var navbarToggler = document.querySelector('.navbar-toggler');
            var navbarCollapse = document.querySelector('#navbarNav');
            var saMenu = document.querySelector('.sa-menu');
            var dropdowns = document.querySelectorAll('.sa-dropdown > a');

            // Evitar flash de menus ao clicar em link de navegação
            document.querySelector('#navbarNav') && document.querySelector('#navbarNav').addEventListener('mousedown', function(e) {
                var link = e.target.closest('a[href]');
                if (link && link.getAttribute('href') && link.getAttribute('href') !== '#' && link.getAttribute('href') !== '') {
                    saMenu && saMenu.classList.add('sa-nav-navigating');
                }
            });
            document.querySelector('#navbarNav') && document.querySelector('#navbarNav').addEventListener('click', function(e) {
                var link = e.target.closest('a[href]');
                if (link && link.getAttribute('href') && link.getAttribute('href') !== '#' && link.getAttribute('href') !== '') {
                    saMenu && saMenu.classList.add('sa-nav-navigating');
                }
            });

            // Controle do menu mobile
            navbarToggler.addEventListener('click', function() {
                if (navbarCollapse.classList.contains('show')) {
                    document.body.classList.remove('no-scroll');
                } else {
                    document.body.classList.add('no-scroll');
                }
            });

            navbarCollapse.addEventListener('hidden.bs.collapse', function() {
                document.body.classList.remove('no-scroll');
            });

            navbarCollapse.addEventListener('shown.bs.collapse', function() {
                document.body.classList.add('no-scroll');
            });

            // Função para fechar todos os dropdowns
            function closeAllDropdowns() {
                document.querySelectorAll('.sa-dropdown-menu').forEach(function(menu) {
                    menu.classList.remove('show');
                });
                document.querySelectorAll('.sa-dropdown > a').forEach(function(link) {
                    link.classList.remove('active');
                });
            }

            // Controle dos dropdowns móveis
            dropdowns.forEach(function(dropdown) {
                dropdown.addEventListener('click', function(e) {
                    if (window.innerWidth <= 991) {
                        e.preventDefault();
                        e.stopPropagation();

                        var submenu = this.nextElementSibling;
                        var isOpen = submenu.classList.contains('show');

                        // Fecha todos os dropdowns
                        closeAllDropdowns();

                        // Se não estava aberto, abre este dropdown
                        if (!isOpen) {
                            submenu.classList.add('show');
                            this.classList.add('active');
                        }
                    }
                });
            });

            // Fecha os dropdowns quando clicar fora
            document.addEventListener('click', function(e) {
                if (window.innerWidth <= 991) {
                    if (!e.target.closest('.sa-dropdown')) {
                        closeAllDropdowns();
                    }
                }
            });

            // Reseta os dropdowns ao redimensionar
            window.addEventListener('resize', function() {
                if (window.innerWidth > 991) {
                    closeAllDropdowns();
                }
            });
        });
    </script>

    <script>
        function atualizarData() {
            const diasSemana = ['Domingo', 'Segunda-feira', 'Terça-feira', 'Quarta-feira', 'Quinta-feira', 'Sexta-feira', 'Sábado'];
            const meses = ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'];

            const data = new Date();
            const diaSemana = diasSemana[data.getDay()];
            const dia = data.getDate();
            const mes = meses[data.getMonth()];
            const ano = data.getFullYear();

            document.getElementById('date_time').innerHTML = `${diaSemana}, ${dia} de ${mes} de ${ano}`;
        }

        atualizarData();
        setInterval(atualizarData, 1000);
    </script>

