<script>
// Slider principal já está configurado acima

// Variáveis globais para o slider
var mainSliderVars = {
    currentSlideIndex: 0,
    autoPlayInterval: null,
    slides: null,
    indicators: null,
    container: null
};

// Função para inicializar o slider
function initializeMainSlider() {
    mainSliderVars.slides = document.querySelectorAll('.slider-slide');
    mainSliderVars.indicators = document.querySelectorAll('.indicator');
    mainSliderVars.container = document.querySelector('.slider-container');

    if (!mainSliderVars.slides.length) return;

    // Mostrar o primeiro slide
    showMainSlide(0);

    // Iniciar autoplay
    startMainSliderAutoPlay();

    // Adicionar eventos de hover
    const slider = document.querySelector('.main-news-slider');
    if (slider) {
        slider.addEventListener('mouseenter', stopMainSliderAutoPlay);
        slider.addEventListener('mouseleave', startMainSliderAutoPlay);
    }
}

// Função para mostrar um slide específico
function showMainSlide(index) {
    // Ajustar o índice se necessário
    if (index >= mainSliderVars.slides.length) {
        mainSliderVars.currentSlideIndex = 0;
    } else if (index < 0) {
        mainSliderVars.currentSlideIndex = mainSliderVars.slides.length - 1;
    } else {
        mainSliderVars.currentSlideIndex = index;
    }

    // Mover o container
    if (mainSliderVars.container) {
        const offset = -mainSliderVars.currentSlideIndex * 100;
        mainSliderVars.container.style.transform = `translateX(${offset}%)`;
    }

    // Atualizar indicadores
    if (mainSliderVars.indicators) {
        mainSliderVars.indicators.forEach((indicator, i) => {
            if (i === mainSliderVars.currentSlideIndex) {
                indicator.classList.add('active');
            } else {
                indicator.classList.remove('active');
            }
        });
    }
}

// Funções de navegação
function changeMainSlide(direction) {
    showMainSlide(mainSliderVars.currentSlideIndex + direction);
}

function goToMainSlide(index) {
    showMainSlide(index - 1);
}

// Funções de autoplay
function startMainSliderAutoPlay() {
    if (mainSliderVars.autoPlayInterval) clearInterval(mainSliderVars.autoPlayInterval);
    mainSliderVars.autoPlayInterval = setInterval(() => {
        changeMainSlide(1);
    }, 5000);
}

function stopMainSliderAutoPlay() {
    if (mainSliderVars.autoPlayInterval) {
        clearInterval(mainSliderVars.autoPlayInterval);
        mainSliderVars.autoPlayInterval = null;
    }
}

// Funções globais para os botões
window.changeSlide = changeMainSlide;
window.currentSlide = goToMainSlide;

// Inicializar quando o DOM estiver pronto
document.addEventListener('DOMContentLoaded', initializeMainSlider);

