<script>
(function () {
    var STORAGE_KEY = 'portal_pb_cookie_consent_v1';
    var banner = document.getElementById('portal-cookie-banner');
    var modal = document.getElementById('portal-cookie-policy-modal');
    if (!banner) return;

    try {
        if (window.localStorage.getItem(STORAGE_KEY) === '1') {
            return;
        }
    } catch (e) {}

    banner.hidden = false;

    function hideBanner() {
        banner.hidden = true;
        try {
            window.localStorage.setItem(STORAGE_KEY, '1');
        } catch (e) {}
    }

    function openPolicyModal() {
        if (!modal) return;
        modal.hidden = false;
        var closeBtn = document.getElementById('portal-cookie-policy-modal-close');
        if (closeBtn) closeBtn.focus();
    }

    function closePolicyModal() {
        if (!modal) return;
        modal.hidden = true;
    }

    var accept = document.getElementById('portal-cookie-banner-accept');
    var policy = document.getElementById('portal-cookie-banner-policy');

    if (accept) {
        accept.addEventListener('click', hideBanner);
    }
    if (policy) {
        policy.addEventListener('click', openPolicyModal);
    }

    if (modal) {
        var backdrop = modal.querySelector('.portal-cookie-policy-modal__backdrop');
        var closeBtn = document.getElementById('portal-cookie-policy-modal-close');
        if (backdrop) backdrop.addEventListener('click', closePolicyModal);
        if (closeBtn) closeBtn.addEventListener('click', closePolicyModal);
        document.addEventListener('keydown', function (ev) {
            if (ev.key === 'Escape' && !modal.hidden) {
                closePolicyModal();
            }
        });
    }
})();
</script>

