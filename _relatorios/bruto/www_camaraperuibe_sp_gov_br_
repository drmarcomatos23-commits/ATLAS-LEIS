document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('ouvidoriaModal');
    const btn = document.getElementById('ouvidoriaButton');
    const span = document.getElementsByClassName('close-ouvidoria')[0];
    const ouvidoriaText = document.getElementById('ouvidoriaText');
    const ouvidoriaButton = document.querySelector('.ouvidoria-float-button');

    if (btn && modal) {
        btn.onclick = function() {
            modal.style.display = 'block';
        }
    }
    if (span && modal) {
        span.onclick = function() {
            modal.style.display = 'none';
        }
    }
    if (modal) {
        window.onclick = function(event) {
            if (event.target == modal) {
                modal.style.display = 'none';
            }
        }
