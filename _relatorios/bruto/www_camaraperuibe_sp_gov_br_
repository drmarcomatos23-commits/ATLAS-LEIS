    <style>
        .font {
            font-family: 'Georgia', 'Times New Roman', serif;
            margin-top: -7px;
        }

        .color {
            background: linear-gradient(135deg, #607d8b, #546e7a);
            color: white;
            position: relative;
            height: 40px;
            width: 100%;
            overflow: hidden;
        }

        .color .container {
            max-width: 100%;
            overflow: hidden;
        }

        .font {
            font-family: 'Georgia', 'Times New Roman', serif;
            margin-top: -7px;
            color: white;
        }

        .header-top-content {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
        }

        .date-section {
            display: flex;
            align-items: center;
        }

        .sa-user {
            display: flex;
            gap: 15px;
            justify-content: center;
            align-items: center;
            font-family: 'Georgia', 'Times New Roman', serif;
            margin-top: -7px;
            position: fixed;
            top: 13px;
            right: 75px;
        }

        .sa-user a {
            color: white;
            text-decoration: none;
            font-size: 14px;
            transition: all 0.3s ease;
        }

        .sa-user a:hover {
            opacity: 0.8;
            transform: translateY(-1px);
        }

        @media (max-width: 991px) {
            .header-top-content {
                flex-direction: column;
                gap: 3px;
                padding: 3px 0;
            }

            .date-section {
                order: 1;
                justify-content: center;
                width: 100%;
            }

            .sa-user {
                order: 2;
                display: flex;
                gap: 6px;
                justify-content: center;
                align-items: center;
                font-family: 'Georgia', 'Times New Roman', serif;
                font-weight: bold;
                color: white;
                position: static;
                width: 100%;
                flex-wrap: wrap;
            }

            .sa-user a {
                color: white;
                font-size: 10px;
                padding: 2px 4px;
            }

            .color {
                height: auto;
                min-height: 35px;
                padding: 2px 0;
            }

            .col-lg-3.order-lg-last {
                display: none !important;
            }
        }

        @media (max-width: 480px) {
            .sa-user {
                gap: 3px;
            }

            .sa-user a {
                font-size: 9px;
                padding: 1px 3px;
            }

            .header-top-content {
                gap: 2px;
                padding: 2px 0;
            }

            .color {
                min-height: 30px;
            }
        }

        .sa-menu {
            background: white;
            padding: 0;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            border-bottom: 1px solid rgba(0,0,0,0.05);
            position: relative;
        }

        /* Estado inicial do menu mobile */
        @media (max-width: 991px) {
            .navbar-collapse {
                display: none !important;
            }

            .navbar-collapse.show {
                display: block !important;
            }
        }

        .sa-menu .container {
            max-width: 1400px;
            padding: 0 30px;
            position: relative;
        }

        .menu-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
