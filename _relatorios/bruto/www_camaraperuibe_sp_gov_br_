/* Estilos do Botão Flutuante da Agenda */
.agenda-float {
    position: fixed;
    bottom: 15px;
    left: 25px;
    z-index: 1000;
}

.agenda-float-button {
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, #607d8b 0%, #546e7a 100%);
    color: white;
    padding: 15px 25px;
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(0,81,72, 0.4);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    gap: 15px;
    position: relative;
    overflow: hidden;
}

.agenda-float-button::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: left 0.6s ease;
}

.agenda-float-button:hover::before {
    left: 100%;
}

.agenda-float-button.compact {
    background: transparent;
    padding: 0;
    box-shadow: none;
}

.agenda-float-button:hover {
    background: linear-gradient(135deg, #78909c 0%, #607d8b 100%);
    color: white;
    text-decoration: none;
    transform: scale(1.08) translateY(-3px);
    box-shadow: 0 8px 30px rgba(96, 125, 139, 0.5);
}

.agenda-float-button.compact:hover {
    background: transparent;
    transform: scale(1.1);
}

.agenda-icon {
    background: rgba(255,255,255,0.2);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: pulse 2s infinite;
}

.agenda-float-button.compact .agenda-icon {
    background: transparent;
    width: 45px;
    height: 45px;
    border: 2px solid rgba(0,81,72, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.agenda-float-button.compact:hover .agenda-icon {
    border-color: rgba(0,81,72, 0.4);
}

.agenda-icon i {
    font-size: 20px;
    color: white;
}

.agenda-float-button.compact .agenda-icon i {
    font-size: 25px;
    color: #607d8b;
}

.agenda-text {
    display: flex;
    flex-direction: column;
    opacity: 1;
    width: auto;
    transition: all 0.3s ease;
}

.agenda-text.hide {
    opacity: 0;
    width: 0;
    margin: 0;
    padding: 0;
    display: none;
}

.agenda-text strong {
    font-size: 14px;
    line-height: 1.2;
}

.agenda-text span {
    font-size: 12px;
    opacity: 0.9;
}

@keyframes pulse {
    0% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.1);
    }
    100% {
        transform: scale(1);
    }
}

@media (max-width: 768px) {
    .agenda-float {
        bottom: 15px;
        left: 15px;
    }

    .agenda-float-button {
        padding: 10px 20px;
    }

    .agenda-float-button.compact {
        padding: 0;
    }

    .agenda-float-button.compact .agenda-icon {
        width: 40px;
        height: 40px;
    }

    .agenda-float-button.compact .agenda-icon i {
        font-size: 22px;
    }

    .agenda-text strong {
        font-size: 12px;
    }

    .agenda-text span {
        font-size: 10px;
