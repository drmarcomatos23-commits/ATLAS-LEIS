    function escolherTipoBase() {
        var baseTerritorialSelecionada = new String("  ");
        var total = 0;

        if ($("#chkMunicipal")[0].checked) {
            baseTerritorialSelecionada = "Municipal, ";
            total++;
        }

        if ($("#chkIntermunicipal")[0].checked) {
            baseTerritorialSelecionada = baseTerritorialSelecionada + "Intermunicipal, ";
            total++;
        }

        if ($("#chkEstadual")[0].checked) {
            baseTerritorialSelecionada = baseTerritorialSelecionada + "Estadual, ";
            total++;
        }

        if ($("#chkInterestadual")[0].checked) {
            baseTerritorialSelecionada = baseTerritorialSelecionada + "Interestadual, ";
            total++;
        }

        if ($("#chkNacional")[0].checked) {
            baseTerritorialSelecionada = baseTerritorialSelecionada + "Nacional, ";
            total++;
        }

        if (total == 5) {
            baseTerritorialSelecionada = "Todos os tipos  ";
        }

        if (total == 0) {
            baseTerritorialSelecionada = "Nenhum tipo selecionado  ";
        }

        return $.trim(baseTerritorialSelecionada.substring(0, baseTerritorialSelecionada.length - 2));
    }

