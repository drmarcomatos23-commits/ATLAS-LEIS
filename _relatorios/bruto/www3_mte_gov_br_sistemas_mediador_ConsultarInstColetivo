    function validarConsulta() {
        var mask = "";
        if (($("#chkNRCNPJ")[0].checked) && ($("#txtNRCNPJ").val() == "")) {
            mask = "99.999.999/9999-99";
            showErro('O campo CNPJ/CAEPF é de preenchimento obrigatório.', '', '', function () { $("#txtNRCNPJ").unmask(mask).select().mask(mask); });
            return false;
        }

        if (($("#chkNRCEI")[0].checked) && ($("#txtNRCEI").val() == "")) {
            mask = "99999999999-9";
            showErro('O campo Matrícula CEI é de preenchimento obrigatório.', '', '', function () { $("#txtNRCEI").unmask(mask).select().mask(mask); });
            return false;
        }

        if (($("#chkNORazaoSocial")[0].checked) && ($("#txtNORazaoSocial").val() == "")) {
            showErro("O campo Razão Social é de preenchimento obrigatório.", "", "", function () { $("#txtNORazaoSocial").val(""); setTimeout(function () { $('#txtNORazaoSocial').focus(); }, 0); });
            return false;
        }

        if (($("#chkCategoria")[0].checked) && ($("#txtDSCategoria").val() == "")) {
            showErro("O campo Categoria é de preenchimento obrigatório.", "", "", function () { $("#txtDSCategoria").val(""); setTimeout(function () { $('#txtDSCategoria').focus(); }, 0); });
            return false;
        }

        mask = "99/99/9999";

        if (($("#chkPeriodoRegistro")[0].checked) && ($("#txtDTInicioRegistro").val() == "")) {
            showErro('O campo Período do Registro é de preenchimento obrigatório.', '', '', function () { $("#txtDTInicioRegistro").unmask(mask).select().mask(mask); });
            return false;
        }

        if (($("#chkPeriodoRegistro")[0].checked) && ($("#txtDTFimRegistro").val() == "")) {
            showErro('O campo Período do Registro é de preenchimento obrigatório.', '', '', function () { $("#txtDTFimRegistro").unmask(mask).select().mask(mask); });
            return false;
        }

        if (($("#chkVigencia")[0].checked) && ($("#txtDTInicioVigencia").val() == "")) {
            showErro('O campo Vigência no Período é de preenchimento obrigatório.', '', '', function () { $("#txtDTInicioVigencia").unmask(mask).select().mask(mask); });
            return false;
        }

        if (($("#chkVigencia")[0].checked) && ($("#txtDTFimVigencia").val() == "")) {
            showErro('O campo Vigência no Período é de preenchimento obrigatório.', '', '', function () { $("#txtDTFimVigencia").unmask(mask).select().mask(mask); });
            return false;
        }

        if (!$("#chkMunicipal").is(":checked") && !$("#chkEstadual").is(":checked") && !$("#chkNacional").is(":checked") && !$("#chkIntermunicipal").is(":checked") && !$("#chkInterestadual").is(":checked")) {
            showErro("Selecione pelo menos um(a) tipo de Abrangência.", null, null, function () { $("#chkMunicipal").focus(); });
            return false;
        }

        if (!validarCEI($("#txtNRCEI")[0], false) && $("#txtNRCEI").val() != "") {
            mask = "99999999999-9";
            showErro('O valor informado no campo Matricula CEI está no formato inválido.', '', '', function () { $("#txtNRCEI").unmask(mask).select().mask(mask); });
            return false;
        }

        mask = "99/99/9999";
        if ($("#chkPeriodoRegistro")[0].checked) {
            if ($.datepicker.parseDate('dd/mm/yy', $("#txtDTFimRegistro").val()) < $.datepicker.parseDate('dd/mm/yy', $("#txtDTInicioRegistro").val())) {
                showErro('A data inicial deve ser anterior ou igual à data final.', '', '', function () { $("#txtDTInicioRegistro").unmask(mask).select().mask(mask); });
                return false;
            }

            var dataFutura = $.datepicker.parseDate('dd/mm/yy', $("#txtDTInicioRegistro").val());
            dataFutura.setFullYear(dataFutura.getFullYear() + 2);

            if ($.datepicker.parseDate('dd/mm/yy', $("#txtDTFimRegistro").val()) > dataFutura) {
                showErro('O intervalo máximo de pesquisa é de dois anos.', '', '', function () { $("#txtDTFimRegistro").unmask(mask).select().mask(mask); });
                return false;
            }
        }

        if ($("#chkVigencia")[0].checked) {
            if ($.datepicker.parseDate('dd/mm/yy', $("#txtDTFimVigencia").val()) < $.datepicker.parseDate('dd/mm/yy', $("#txtDTInicioVigencia").val())) {
                showErro('A data inicial deve ser anterior ou igual à data final.', '', '', function () { $("#txtDTInicioVigencia").unmask(mask).select().mask(mask); });
                return false;
            }

            var dataFutura = $.datepicker.parseDate('dd/mm/yy', $("#txtDTInicioVigencia").val());
            dataFutura.setFullYear(dataFutura.getFullYear() + 1);

            if ($.datepicker.parseDate('dd/mm/yy', $("#txtDTFimVigencia").val()) > dataFutura) {
                showErro('O intervalo máximo de pesquisa é de um ano.', '', '', function () { $("#txtDTFimVigencia").unmask(mask).select().mask(mask); });
                return false;
            }
        }
        if ($("#txtNOTituloClausula").val() != "") {
            if ($("#txtNOTituloClausula").val().length < 4) {
                showErro('Deve ser informado no mínimo 4 caracteres no campo Palavra do Título.', null, null, function () { $("#txtNOTituloClausula").select().focus(); });
                return false;
            }
        }

        if (!$("#cboSTVigencia").val()) {
            showErro("O campo Vigência é de preenchimento obrigatório.");
            return false;
        }

        if ($("#cboTPRequerimento").val() == "") {
            var baseTerritorialSelecionada = escolherTipoBase();
            if (!$("#txtNRCNPJ").val() && !$("#txtNRCEI").val() && !$("#txtNORazaoSocial").val() &&
                !$("#txtDSCategoria").val() && !$("#cboUFRegistro").val() && !$("#txtDTInicioRegistro").val() &&
                !$("#txtDTFimRegistro").val() && !$("#txtDTInicioVigencia").val() && !$("#txtDTFimVigencia").val() &&
                !$("#cboGrupoClausula").val() && !$("#cboSubGrupoClausula").val() && !$("#txtNOTituloClausula").val() &&
                baseTerritorialSelecionada == "Todos os tipos" && !$("#btnExcluirTodos").is(':visible')
            ) {
                showErro("Informe pelo menos um parâmetro.");
                return false;
            }
        }
        return true;
    }

