function makeul(list) {
    var materias = createHierarchyPathsBusca(list);
    var html = '';
    
    for (var i = 0; i < materias.length; i++) {
        var materia = materias[i];
        
        var name = materia.title.split("_");
        var title = name[0];
        var urlTitle = name[1];
        var content = materia.content;
        
        var pubDate = materia.pubDate;
        var pubName = materia.pubName;
        
        var editionNumber = materia.editionNumber;
        var pageNumber = materia.pageNumber;
        
        var sectionNumber = pubName;

        if(sectionNumber.includes("_EXTRA_")){
            let words = sectionNumber.split("_");
            sectionNumber = words[0].replace( /^\D+/g, '') + " Edi&ccedil;&atilde;o Extra " + words[2];
        } else {
            sectionNumber = sectionNumber === "DO1E" ? "1 Edi&ccedil;&atilde;o Extra" : sectionNumber;
            sectionNumber = sectionNumber === "DO2E" ? "2 Edi&ccedil;&atilde;o Extra" : sectionNumber;
            sectionNumber = sectionNumber === "DO3E" ? "3 Edi&ccedil;&atilde;o Extra" : sectionNumber;
            
            sectionNumber = sectionNumber === "DO1ESP" 		? "1 Edi&ccedil;&atilde;o Especial" : sectionNumber;
            sectionNumber = sectionNumber === "DO2ESP" 		? "2 Edi&ccedil;&atilde;o Especial" : sectionNumber;
            sectionNumber = sectionNumber === "DO1_SUP" 	? "1 Suplemento" : sectionNumber;
            sectionNumber = sectionNumber === "ANVISA" 		? "1 Suplemento Anvisa" : sectionNumber;
            sectionNumber = sectionNumber === "ORCAMENTO" 	? "1 Suplemento Or&ccedil;ament&aacute;rio" : sectionNumber;
            
            sectionNumber = sectionNumber === "DO1A" 	? "1 Suplemento Anvisa" : sectionNumber;
            sectionNumber = sectionNumber === "DO1" 	? "1" : sectionNumber;
            sectionNumber = sectionNumber === "DO2" 	? "2" : sectionNumber;
            sectionNumber = sectionNumber === "DO3" 	? "3" : sectionNumber;
        }

        
        var score = materia.score;
        
        html += '<div class="resultados-wrapper">\n';
        html += '  <div class="resultado">\n';
        html += '    <ol class="dou-hierarquia breadcrumb">\n';
        html += '      <li class="breadcrumb-item secao-marker">' + "Se&ccedil;&atilde;o " + sectionNumber + '</li>\n';
        materia.hierarchy.forEach(currentValue =>
        html += '      <li class="breadcrumb-item hierarchy-item-marker">' + currentValue + '</li>\n');
        html += '      <li class="breadcrumb-item publication-info-marker">' + "Edi&ccedil;&atilde;o N&ordm; " + editionNumber + " de " + pubDate + " - P&aacute;g. " + pageNumber + '</li>\n';
        html += '    </ol>\n';
        html += '    <h5 class="title-marker">\n';
        html += '      <a href="' + createURLByUrlTitle(urlTitle) + '" data-senna-off="true">\n';
        html += '        ' + title + '\n';
        html += '      </a>\n';
        html += '    </h5>\n';
        html += '    <p class="abstract-marker">' + content + '</p>\n';
        html += '    <p class="date-marker">' + pubDate + '</p>\n';
        html += '  </div>\n';
        html += '</div>\n';
    }
    return html;
}

function createHierarchyPathsBusca(list) {
    var allPaths = [];
    if(list.length > 0){
        for (var i = 0; i < list.length; i++) {
            allPaths.push({
                'score':list[i].score ,
                'hierarchy': list[i].hierarchyList,
                'title': list[i].title + "_" + list[i].urlTitle,
                'hierarchyStr': list[i].hierarchyStr,
                'content': list[i].content,
                'pubDate': list[i].pubDate,
                'pubName': list[i].pubName,
                'type': list[i].artType,
                'editionNumber': list[i].editionNumber,
                'pageNumber': list[i].numberPage
            });
        }
    }
    return allPaths;
}
			
